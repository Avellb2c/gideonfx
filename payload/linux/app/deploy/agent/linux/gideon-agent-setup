  fi
  report="$(gideon_collect_diagnostics "SELF_TEST_FAILED_RC_$rc" "gideon_agent.py --self-test")"
  echo "GIDEON_DIAGNOSTIC_FILE=$report"
  echo "GIDEON_ERROR_FULL=Self-test Gateway falló rc=$rc; Agent instalado y servicio dejado activo para reintento."
  exit "$rc"
fi

rm -f "$BOOTSTRAP"
systemctl restart gideon-agent.service
sleep 2
systemctl is-active --quiet gideon-agent.service || die "gideon-agent.service no quedó activo"
gideon_final_acceptance_linux
log "PASS: GIDEONAgent Linux activo con Reverse Tunnel universal. FINAL_ACCEPTANCE=PASS"
