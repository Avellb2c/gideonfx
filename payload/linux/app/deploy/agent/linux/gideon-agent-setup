def deep_defaults(dst,src):
    if not isinstance(dst,dict) or not isinstance(src,dict): return dst
    out=copy.deepcopy(dst)
    for k,v in src.items():
        if k not in out:
            out[k]=copy.deepcopy(v)
        elif isinstance(out[k],dict) and isinstance(v,dict):
