#!/usr/bin/env bash
set -euo pipefail
ROOT="${GIDEON_AGENT_ROOT:-/opt/gideon-agent}"
TARGET_VERSION="2.4.56"
CONFIG="$ROOT/agent.json"
TEMPLATE="$ROOT/agent.template.json"
BOOTSTRAP="$ROOT/bootstrap.enrollment"
STATE="/var/lib/gideon-agent"
LOG="$STATE/install.log"
SERVICE="/etc/systemd/system/gideon-agent.service"
mkdir -p "$STATE"; touch "$LOG"; chmod 600 "$LOG" || true
DIAG_DIR="$STATE/diagnostics"
mkdir -p "$DIAG_DIR"
log(){ printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$*" | tee -a "$LOG"; }

gideon_collect_diagnostics(){
  local reason="${1:-UNKNOWN_FAILURE}"
  local command_text="${2:-}"
  local stamp raw report redactor
  stamp="$(date +%Y%m%d_%H%M%S)"
  raw="$DIAG_DIR/.raw-$stamp-$$.txt"
  report="$DIAG_DIR/install-error-$stamp.txt"

  {
    echo "============================================================"
    echo "GIDEON REMOTE CONTROL AGENT - INSTALLATION DIAGNOSTIC"
    echo "============================================================"
    echo "Timestamp: $(date --iso-8601=seconds 2>/dev/null || date)"
    echo "Reason: $reason"
    echo "Command/Stage: $command_text"
    echo "Agent target version: $TARGET_VERSION"
    echo "SiteCode: ${site_code:-UNKNOWN}"
    echo "SiteName: ${site_name:-UNKNOWN}"
    echo "AgentName: ${agent_name:-UNKNOWN}"
    echo "Gateway: ${gateway:-UNKNOWN}"
    echo
    echo "=== OS / ARCH ==="
    uname -a 2>&1 || true
    if [[ -f /etc/os-release ]]; then cat /etc/os-release 2>&1 || true; fi
    command -v dpkg >/dev/null 2>&1 && dpkg --print-architecture 2>&1 || true
    command -v rpm >/dev/null 2>&1 && rpm --eval '%{_arch}' 2>&1 || true
    echo
    echo "=== RUNTIME ==="
    if [[ -n "${PY:-}" && -x "${PY:-}" ]]; then
      "$PY" -V 2>&1 || true
      "$PY" - "$ROOT" <<'PY' 2>&1 || true
import sys
root=sys.argv[1]
sys.path.insert(0,root)
try:
    import gideon_agent,gideon_reverse_tunnel
    print("AgentVersion:",getattr(gideon_agent,"VERSION","?"))
    print("ReverseTunnelAPI:",getattr(gideon_reverse_tunnel,"TUNNEL_API_VERSION","?"))
except Exception as exc:
    print("RuntimeImportError:",type(exc).__name__,str(exc))
PY
    fi
    echo
    echo "=== CONFIG (SANITIZED FIELDS ONLY) ==="
    if [[ -s "$CONFIG" && -n "${PY:-}" && -x "${PY:-}" ]]; then
      "$PY" - "$CONFIG" <<'PY' 2>&1 || true
import json,sys
try:
    c=json.load(open(sys.argv[1],encoding="utf-8-sig"))
    cp=c.get("control_plane") if isinstance(c.get("control_plane"),dict) else {}
    rt=c.get("reverse_tunnel") if isinstance(c.get("reverse_tunnel"),dict) else {}
    print("site_code:",c.get("site_code"))
    print("site_name:",c.get("site_name"))
    print("agent_name:",c.get("agent_name"))
    print("agent_version:",c.get("agent_version"))
    print("gateway:",cp.get("base_url"))
    print("reverse_tunnel.enabled:",rt.get("enabled"))
    print("reverse_tunnel.transport:",rt.get("transport"))
    print("reverse_tunnel.protocol_version:",rt.get("protocol_version"))
except Exception as exc:
    print("ConfigReadError:",type(exc).__name__,str(exc))
PY
    else
      echo "agent.json: MISSING"
    fi
    echo
    echo "=== GIDEON AGENT SERVICE ==="
    systemctl status gideon-agent.service --no-pager -l 2>&1 || true
    echo
    echo "=== XRDP SERVICE ==="
    systemctl status xrdp.service --no-pager -l 2>&1 || true
    echo
    echo "=== LISTENERS ==="
    command -v ss >/dev/null 2>&1 && ss -lntp 2>&1 | grep -E '(:3389|:5900|LISTEN)' || true
    echo
    echo "=== GIDEON PROCESS ==="
    ps -eo pid,ppid,user,comm,args 2>&1 | grep -E '[d]pp_agent.py|[x]rdp' || true
    echo
    echo "=== JOURNAL GIDEON AGENT (LAST 120) ==="
    journalctl -u gideon-agent.service -n 120 --no-pager 2>&1 || true
    echo
    echo "=== JOURNAL XRDP (LAST 80) ==="
    journalctl -u xrdp.service -n 80 --no-pager 2>&1 || true
    echo
    echo "=== INSTALL LOG (LAST 180) ==="
    tail -n 180 "$LOG" 2>&1 || true
    echo
    echo "============================================================"
    echo "END DIAGNOSTIC"
    echo "============================================================"
  } >"$raw" 2>&1

  redactor="${PY:-$(command -v python3 2>/dev/null || true)}"
  if [[ -n "$redactor" && -x "$redactor" ]]; then
    "$redactor" - "$raw" "$report" <<'PY' 2>/dev/null || cp -f "$raw" "$report"
import re,sys
src,dst=sys.argv[1],sys.argv[2]
text=open(src,encoding="utf-8",errors="replace").read()
patterns=[
    r'(?i)(enrollment[_ -]?secret\s*[:=]\s*)[^\s,;"\']+',
    r'(?i)(\btoken\s*[:=]\s*)[^\s,;"\']+',
    r'(?i)(\bpassword\s*[:=]\s*)[^\s,;"\']+',
    r'(?i)(authorization\s*[:=]\s*)[^\r\n]+',
    r'(?i)(bearer\s+)[A-Za-z0-9._~+/=-]+',
]
for pat in patterns:
    text=re.sub(pat,lambda m:m.group(1)+"***REDACTED***",text)
open(dst,"w",encoding="utf-8").write(text)
PY
  else
    cp -f "$raw" "$report"
  fi
  rm -f "$raw" 2>/dev/null || true
  chmod 0644 "$report" 2>/dev/null || true
  printf '%s\n' "$report"
}

gideon_fail(){
  local msg="$*"
  log "ERROR: $msg"
  local report
  report="$(gideon_collect_diagnostics "$msg" "explicit-failure")"
  echo "GIDEON_DIAGNOSTIC_FILE=$report"
  echo "GIDEON_ERROR_FULL=$msg"
  exit 1
}
die(){ gideon_fail "$@"; }

gideon_on_error(){
  local rc="$1" line="$2" cmd="$3"
  trap - ERR
  log "UNHANDLED_ERROR rc=$rc line=$line command=$cmd"
  local report
  report="$(gideon_collect_diagnostics "UNHANDLED_ERROR rc=$rc line=$line" "$cmd")"
  echo "GIDEON_DIAGNOSTIC_FILE=$report"
  exit "$rc"
}
trap 'gideon_on_error $? $LINENO "$BASH_COMMAND"' ERR
if [[ "$(id -u)" -ne 0 ]]; then
  if [[ "$#" -eq 0 && -x "$ROOT/gideon-agent-first-run-native" ]]; then
    exec "$ROOT/gideon-agent-first-run-native"
  fi
  die "Ejecute gideon-agent-setup sin argumentos para la GUI nativa o use sudo gideon-agent-setup en modo consola."
fi
[[ -f "$TEMPLATE" ]] || die "No existe $TEMPLATE"
PY="$ROOT/venv/bin/python"
command -v python3 >/dev/null 2>&1 || die "python3 no instalado"
# Re-running venv is intentional: it also upgrades an older isolated venv so
# Debian/Raspberry Pi OS packages such as python3-cryptography and python3-pil
# are visible, avoiding native Pillow/cffi builds on ARMHF.
python3 -m venv --system-site-packages "$ROOT/venv"
grep -Eiq '^include-system-site-packages[[:space:]]*=[[:space:]]*true$' "$ROOT/venv/pyvenv.cfg" \
  || die "GIDEON_DEPENDENCY_ERROR: el venv no expone paquetes Python del sistema."
[ -d "$ROOT/vendor" ] && [ ! -L "$ROOT/vendor" ] \
  || die "GIDEON_DEPENDENCY_ERROR: faltan dependencias offline firmadas en $ROOT/vendor."
"$ROOT/venv/bin/pip" install --no-index --find-links="$ROOT/vendor" --disable-pip-version-check --only-binary=:all: --no-deps -r "$ROOT/requirements-agent.txt"
"$PY" -c "import sys;sys.path.insert(0,'$ROOT');import gideon_agent,gideon_reverse_tunnel,gideon_common;assert gideon_reverse_tunnel.TUNNEL_API_VERSION==gideon_agent.REVERSE_TUNNEL_API_REQUIRED;print('runtime',gideon_agent.VERSION,'rt-api',gideon_reverse_tunnel.TUNNEL_API_VERSION)"

gideon_validate_installer_contract_linux(){
  "$PY" - "$ROOT" "$TARGET_VERSION" <<'PY'
import hashlib,json,os,re,sys
root,expected=sys.argv[1:3]
cp=os.path.join(root,"installer.contract.json")
if not os.path.isfile(cp): raise SystemExit("INSTALLER_CONTRACT_FILE_MISSING")
with open(cp,encoding="utf-8-sig") as f: c=json.load(f)
if c.get("schema")!="gideon-agent-installer-contract/v2": raise SystemExit("INSTALLER_CONTRACT_SCHEMA_MISMATCH")
if c.get("status")!="PASS": raise SystemExit("INSTALLER_CONTRACT_STATUS_NOT_PASS")
if c.get("platform")!="linux": raise SystemExit("INSTALLER_CONTRACT_PLATFORM_MISMATCH")
if str(c.get("agent_version") or "")!=expected: raise SystemExit("INSTALLER_CONTRACT_VERSION_MISMATCH")
for rel in c.get("required_files") or []:
    if not os.path.isfile(os.path.join(root,str(rel))): raise SystemExit("INSTALLER_REQUIRED_FILE_MISSING:"+str(rel))
for rel,want in (c.get("required_file_sha256") or {}).items():
    p=os.path.join(root,rel)
    h=hashlib.sha256(open(p,"rb").read()).hexdigest()
    if h.lower()!=str(want).lower(): raise SystemExit("INSTALLER_REQUIRED_FILE_HASH_MISMATCH:"+rel)
t=json.load(open(os.path.join(root,"agent.template.json"),encoding="utf-8-sig"))
r=json.load(open(os.path.join(root,"runtime.contract.json"),encoding="utf-8-sig"))
if str(t.get("agent_version") or "")!=expected: raise SystemExit("INSTALLER_TEMPLATE_VERSION_MISMATCH")
if str(r.get("agent_version") or "")!=expected: raise SystemExit("RUNTIME_CONTRACT_VERSION_MISMATCH")
sys.path.insert(0,root);import gideon_agent
if str(gideon_agent.VERSION)!=expected: raise SystemExit("INSTALLER_RUNTIME_VERSION_MISMATCH")
print("INSTALLER_CONTRACT PASS platform=linux version="+expected)
PY
}
gideon_validate_installer_contract_linux
log "INSTALLER_CONTRACT PASS: platform=linux version=$TARGET_VERSION service=systemd"

site_code=""; site_name=""; agent_name="$(hostname 2>/dev/null || echo GIDEONAgent)"; gateway=""; enroll=""; non_interactive=0
remote_access_supported=1

gideon_linux_desktop_available(){
  command -v x-session-manager >/dev/null 2>&1 && return 0
  compgen -G '/usr/share/xsessions/*.desktop' >/dev/null 2>&1 && return 0
  compgen -G '/usr/share/wayland-sessions/*.desktop' >/dev/null 2>&1 && return 0
  return 1
}

configure_gideon_xrdp_session_isolation(){
  [[ -f /etc/xrdp/startwm.sh ]] || return 0

  # A Raspberry Pi may keep a physical Wayland/labwc session alive for the
  # kiosk while XRDP opens an independent Xorg desktop for the operator.  If
  # both desktops inherit /run/user/<uid>/bus, LXDE components attach to the
  # physical session and XRDP exposes a valid but permanently black canvas.
  # Give every XRDP display its own runtime directory and D-Bus session.
  [[ -f /etc/xrdp/startwm.sh.gideon-original ]] || \
    cp -pf /etc/xrdp/startwm.sh /etc/xrdp/startwm.sh.gideon-original
  cat > /etc/xrdp/startwm.sh <<'GIDEON_XRDP_STARTWM'
#!/bin/sh
unset DBUS_SESSION_BUS_ADDRESS
unset WAYLAND_DISPLAY
unset WAYLAND_SOCKET
export XDG_SESSION_TYPE=x11

runtime_suffix=$(printf '%s' "${DISPLAY:-xrdp}" | tr -cd 'A-Za-z0-9_.-')
export XDG_RUNTIME_DIR="/tmp/gideon-xrdp-${UID:-$(id -u)}-${runtime_suffix}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

if command -v startlxde-pi >/dev/null 2>&1; then
  export XDG_CURRENT_DESKTOP=LXDE
  export DESKTOP_SESSION=LXDE-pi
  session=$(command -v startlxde-pi)
elif command -v startlxde >/dev/null 2>&1; then
  export XDG_CURRENT_DESKTOP=LXDE
  export DESKTOP_SESSION=LXDE
  session=$(command -v startlxde)
elif command -v startxfce4 >/dev/null 2>&1; then
  export XDG_CURRENT_DESKTOP=XFCE
  export DESKTOP_SESSION=xfce
  session=$(command -v startxfce4)
elif command -v mate-session >/dev/null 2>&1; then
  session=$(command -v mate-session)
elif command -v gnome-session >/dev/null 2>&1; then
  session=$(command -v gnome-session)
else
  session=/etc/X11/Xsession
fi

if command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- "$session"
fi
if command -v dbus-launch >/dev/null 2>&1; then
  exec dbus-launch --exit-with-session "$session"
fi
exec "$session"
GIDEON_XRDP_STARTWM
  chmod 755 /etc/xrdp/startwm.sh
  log "REMOTE_ACCESS_SESSION_ISOLATION XRDP display/runtime/DBus separados de la sesión física."
}

configure_gideon_xrdp_session_lifecycle(){
  [[ -f /etc/xrdp/sesman.ini ]] || return 0
  [[ -f /etc/xrdp/sesman.ini.gideon-original ]] || \
    cp -pf /etc/xrdp/sesman.ini /etc/xrdp/sesman.ini.gideon-original

  "$PY" - /etc/xrdp/sesman.ini <<'PY'
from pathlib import Path
import re,sys
p=Path(sys.argv[1])
lines=p.read_text(encoding="utf-8",errors="replace").splitlines()
wanted={
    "killdisconnected":"KillDisconnected=true",
    "disconnectedtimelimit":"DisconnectedTimeLimit=300",
    "idletimelimit":"IdleTimeLimit=0",
}
out=[];section="";seen=set();sessions_seen=False
for line in lines:
    match=re.match(r"^\s*\[([^\]]+)\]\s*$",line)
    if match:
        if section.casefold()=="sessions":
            for key,value in wanted.items():
                if key not in seen: out.append(value)
        section=match.group(1).strip();seen=set()
        if section.casefold()=="sessions": sessions_seen=True
        out.append(line);continue
    if section.casefold()=="sessions":
        setting=re.match(r"^\s*([^#;=]+)\s*=",line)
        key=setting.group(1).strip().casefold() if setting else ""
        if key in wanted:
            if key not in seen: out.append(wanted[key]);seen.add(key)
            continue
    out.append(line)
if section.casefold()=="sessions":
    for key,value in wanted.items():
        if key not in seen: out.append(value)
if not sessions_seen:
    out.extend(["","[Sessions]",*wanted.values()])
p.write_text("\n".join(out)+"\n",encoding="utf-8")
PY
  log "REMOTE_ACCESS_SESSION_LIFECYCLE sesiones XRDP desconectadas se conservan 5 minutos y luego se limpian."
}

configure_gideon_xrdp_arm_software_rendering(){
  case "$(uname -m 2>/dev/null || true)" in
    arm*|aarch64) ;;
    *) return 0 ;;
  esac
  [[ -f /etc/X11/xrdp/xorg.conf ]] || return 0
  [[ -f /etc/X11/xrdp/xorg.conf.gideon-original ]] || \
    cp -pf /etc/X11/xrdp/xorg.conf /etc/X11/xrdp/xorg.conf.gideon-original

  "$PY" - /etc/X11/xrdp/xorg.conf <<'PY'
from pathlib import Path
import re,sys
p=Path(sys.argv[1])
lines=p.read_text(encoding="utf-8",errors="replace").splitlines()
out=[];section="";device_is_xrdp=False;device=[]
def flush_device():
    global device
    if not device:return
    cleaned=[]
    for row in device:
        if re.match(r'^\s*Option\s+"(?:DRMDevice|DRI|DRI3|Glamor)"',row,re.I):continue
        cleaned.append(row)
    insert=max(1,len(cleaned)-1)
    cleaned[insert:insert]=[
        '    Option "DRMDevice" ""',
        '    Option "DRI" "0"',
        '    Option "DRI3" "0"',
        '    Option "Glamor" "off"',
    ]
    out.extend(cleaned);device=[]
for line in lines:
    start=re.match(r'^\s*Section\s+"([^"]+)"',line,re.I)
    if start:
        section=start.group(1).casefold()
        if section=='device':device=[line];device_is_xrdp=False;continue
    if section=='device':
        device.append(line)
        if re.search(r'Identifier\s+"Video Card \(xrdpdev\)"',line,re.I):device_is_xrdp=True
        if re.match(r'^\s*EndSection\s*$',line,re.I):
            if device_is_xrdp:flush_device()
            else:out.extend(device);device=[]
            section=""
        continue
    if section=='serverflags' and re.match(r'^\s*EndSection\s*$',line,re.I):
        if not any(re.match(r'^\s*Option\s+"AutoAddGPU"',row,re.I) for row in out[-20:]):
            out.append('    Option "AutoAddGPU" "off"')
    out.append(line)
if device:out.extend(device)
p.write_text("\n".join(out)+"\n",encoding="utf-8")
PY
  log "REMOTE_ACCESS_ARM_SOFTWARE_RENDERING XRDP sin DRM/glamor; sesión física no modificada."
}

ensure_gideon_remote_access_linux() {
  log "REMOTE_ACCESS_STAGE linux-xrdp: preparando xrdp loopback-only."

  if ! gideon_linux_desktop_available; then
    remote_access_supported=0
    log "UNSUPPORTED_HEADLESS_NO_DESKTOP: no hay x-session-manager ni sesión X11/Wayland instalada. Se omite XRDP; Agent/SSH continúan disponibles."
    return 0
  fi

  if ! command -v xrdp >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y xrdp xorgxrdp dbus-x11 || apt-get install -y xrdp dbus-x11
    elif command -v dnf >/dev/null 2>&1; then
      dnf install -y xrdp || die "REMOTE_ACCESS_XRDP_INSTALL_FAILED: dnf no pudo instalar xrdp. Configure el repositorio aprobado y reintente."
    elif command -v yum >/dev/null 2>&1; then
      yum install -y xrdp || die "REMOTE_ACCESS_XRDP_INSTALL_FAILED: yum no pudo instalar xrdp."
    elif command -v zypper >/dev/null 2>&1; then
      zypper --non-interactive install xrdp || die "REMOTE_ACCESS_XRDP_INSTALL_FAILED: zypper no pudo instalar xrdp."
    elif command -v pacman >/dev/null 2>&1; then
      pacman -S --noconfirm --needed xrdp || die "REMOTE_ACCESS_XRDP_INSTALL_FAILED: pacman no pudo instalar xrdp."
    else
      die "REMOTE_ACCESS_XRDP_INSTALL_UNSUPPORTED: no se encontró apt/dnf/yum/zypper/pacman."
    fi
  fi

  [[ -f /etc/xrdp/xrdp.ini ]] || die "REMOTE_ACCESS_XRDP_CONFIG_MISSING: /etc/xrdp/xrdp.ini"

  cp -pf /etc/xrdp/xrdp.ini "/etc/xrdp/xrdp.ini.gideon-backup" 2>/dev/null || true

  "$PY" - /etc/xrdp/xrdp.ini <<'PY'
from pathlib import Path
import re,sys
p=Path(sys.argv[1])
text=p.read_text(encoding="utf-8",errors="replace")
lines=text.splitlines()
section=""
globals_seen=False
port_written=False
out=[]
for line in lines:
    m=re.match(r"^\s*\[([^\]]+)\]\s*$",line)
    if m:
        if section.casefold()=="globals" and not port_written:
            out.append("port=tcp://127.0.0.1:3389")
            port_written=True
        section=m.group(1).strip()
        if section.casefold()=="globals":
            globals_seen=True
        out.append(line)
        continue
    if section.casefold()=="globals":
        # Modern xrdp reliably honors the bind address when it is encoded in
        # the port URI.  The separate "address=" key is ignored by builds that
        # otherwise log address [0.0.0.0].
        if re.match(r"^\s*address\s*=",line,re.I):
            continue
        if re.match(r"^\s*port\s*=",line,re.I):
            if not port_written:
                out.append("port=tcp://127.0.0.1:3389")
                port_written=True
            continue
    out.append(line)
if section.casefold()=="globals" and not port_written:
    out.append("port=tcp://127.0.0.1:3389")
    port_written=True
if not globals_seen:
    raise SystemExit("XRDP_GLOBALS_SECTION_MISSING")
p.write_text("\n".join(out)+"\n",encoding="utf-8")
PY

  configure_gideon_xrdp_session_isolation
  configure_gideon_xrdp_session_lifecycle
  configure_gideon_xrdp_arm_software_rendering

  # Debian/Ubuntu commonly need xrdp access to the ssl-cert group.
  if getent group ssl-cert >/dev/null 2>&1 && id xrdp >/dev/null 2>&1; then
    usermod -a -G ssl-cert xrdp >/dev/null 2>&1 || true
  fi

  systemctl enable xrdp.service >/dev/null
  systemctl restart xrdp.service

  # Do not open and immediately close an RDP socket as a health check: xrdp
  # records that as a failed X.224 handshake. Validate service + real listener
  # state from the kernel instead.
  ready=0
  listener=""
  for _ in $(seq 1 25); do
    if systemctl is-active --quiet xrdp.service && command -v ss >/dev/null 2>&1; then
      listener="$(ss -H -ltn 2>/dev/null | awk '$4 ~ /:3389$/ {print $4; exit}')"
      if [[ "$listener" == "127.0.0.1:3389" ]]; then
        ready=1
        break
      fi
      if [[ -n "$listener" ]]; then
        log "REMOTE_ACCESS_WAIT: xrdp escucha en $listener; esperando loopback 127.0.0.1:3389."
      fi
    fi
    sleep 0.4
  done
  [[ "$ready" -eq 1 ]] || die "REMOTE_ACCESS_XRDP_BIND_FAILED: esperado 127.0.0.1:3389; observado=${listener:-NONE}. No se declara READY con listener global."

  # SECURITY: do not add UFW/firewalld rules. xrdp is explicitly bound to loopback.
  log "REMOTE_ACCESS_READY linux-xrdp 127.0.0.1:3389 VERIFIED_LOOPBACK; no inbound firewall rule added by GIDEON."
}



gideon_import_legacy_linux_config(){
  [[ -s "$CONFIG" ]] && return 0
  local candidate
  for candidate in \
    "/opt/GIDEONAgent/agent.json" \
    "/usr/local/gideon-agent/agent.json" \
    "/usr/local/GIDEONAgent/agent.json" \
    "/var/lib/gideon-agent/agent.json"; do
    if [[ -s "$candidate" && "$candidate" != "$CONFIG" ]]; then
      mkdir -p "$ROOT"
      cp -pf "$candidate" "$CONFIG"
      chmod 600 "$CONFIG" 2>/dev/null || true
      log "ORPHAN_MIGRATION legacy config importado desde $candidate"
      return 0
    fi
  done
  return 0
}

gideon_rebuild_config_from_runtime_linux(){
  [[ -s "$CONFIG" ]] && return 0
  [[ -s "$STATE/agent.runtime.json" ]] || return 0
  if "$PY" - "$TEMPLATE" "$STATE/agent.runtime.json" "$CONFIG" "${site_code:-}" "${site_name:-}" "${agent_name:-}" <<'PY'
import copy,json,os,sys,tempfile
template_path,runtime_path,out_path,requested_site,requested_name,requested_agent=sys.argv[1:7]
t=json.load(open(template_path,encoding="utf-8-sig")); r=json.load(open(runtime_path,encoding="utf-8-sig"))
rt_site=str(r.get("site_code") or "").strip(); template_site=str(t.get("site_code") or "").strip()
target_site=str(requested_site or template_site or rt_site).strip()
if not rt_site or not target_site or rt_site!=target_site: raise SystemExit(3)
site_name=str(requested_name or t.get("site_name") or r.get("site_name") or "").strip()
agent_name=str(requested_agent or t.get("agent_name") or r.get("agent_name") or "").strip()
if not site_name: raise SystemExit(4)
cfg=copy.deepcopy(t); cfg["site_code"]=target_site;cfg["site_name"]=site_name
if agent_name: cfg["agent_name"]=agent_name
for key in ("agent_id","agent_token"):
    if r.get(key) not in (None,""): cfg[key]=r[key]
fd,tmp=tempfile.mkstemp(prefix=".agent-runtime-rebuild.",suffix=".json",dir=os.path.dirname(out_path));os.close(fd)
