[Unit]
Description=GIDEON private resident ClamAV scanner
PartOf=gideon-remote-control.target
After=local-fs.target clamav-freshclam.service
Wants=clamav-freshclam.service

[Service]
Type=simple
User=clamav
Group=clamav
SupplementaryGroups=gideonweb
ExecStart=/usr/sbin/clamd --foreground=true --config-file=/etc/gideon/security/clamd.conf
Restart=on-failure
RestartSec=5
RuntimeDirectory=gideon-clamd
RuntimeDirectoryMode=0755
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/var/lib/gideon/web -/etc/gideon/web -/var/lib/gideon/gateway -/etc/gideon/gateway -/var/lib/gideon/secrets
MemoryHigh=1536M
MemoryMax=2304M
TasksMax=128
LimitNOFILE=4096
TimeoutStartSec=180

[Install]
WantedBy=gideon-remote-control.target
