# GIDEON Web Admin - ejemplo Nginx para el hostname administrativo.
# El Gateway de Agents se recomienda publicar por un hostname/canal separado.
# Si require_agent_mtls=true, use TLS pass-through (AWS NLB o nginx stream) para
# que el certificado cliente llegue al Gateway; NO termine ese mTLS en este bloque HTTP.

server {
    listen 443 ssl http2;
    server_name admin-drc.example.com;

    ssl_certificate     /etc/letsencrypt/live/admin-drc.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin-drc.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 1024m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_connect_timeout 10s;
    }
}
