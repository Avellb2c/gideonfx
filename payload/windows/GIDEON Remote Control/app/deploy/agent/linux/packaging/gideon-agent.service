[Unit]
Description=GIDEON Cross-Platform Agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/gideon-agent/agent.json

[Service]
Type=simple
ExecStart=/usr/lib/gideon-agent/venv/bin/python /usr/lib/gideon-agent/gideon_agent.py --config /etc/gideon-agent/agent.json
WorkingDirectory=/var/lib/gideon-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gideon-agent /etc/gideon-agent

[Install]
WantedBy=multi-user.target
